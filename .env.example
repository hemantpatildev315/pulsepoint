# cPanel / phpMyAdmin MySQL Database Credentials
# Update these values to match your cPanel MySQL Database credentials:
# Example: DB_USER=cpaneluser_clinicuser, DB_NAME=cpaneluser_clinicdb
DB_HOST=localhost
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name
DB_PORT=3306

# Node Server Port (cPanel Node.js Selector sets PORT automatically)
PORT=3000
